{
  "sourceLanguage": "en",
  "strings": {
    "barcodeScanner.codesDetected %lld": {
      "comment": "Heading of the barcode results panel. %lld is how many codes the pass found.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld code detected"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld codes detected"
                }
              }
            }
          }
        }
      }
    },
    "barcodeScanner.title": {
      "comment": "Navigation title of the barcode scanner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcode Scanner"
          }
        }
      }
    },
    "biometric.authenticating": {
      "comment": "Accessibility value while the biometric prompt is up. Present participle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticating"
          }
        }
      }
    },
    "biometric.faceID": {
      "comment": "Button that starts Face ID sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Face ID"
          }
        }
      }
    },
    "biometric.reason": {
      "comment": "Shown by the system inside the Face ID / Touch ID prompt, so it must say why the app is asking.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticate to access your account"
          }
        }
      }
    },
    "biometric.touchID": {
      "comment": "Button that starts Touch ID sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Touch ID"
          }
        }
      }
    },
    "biometric.unavailable": {
      "comment": "Button title when the device has no usable biometric hardware.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Biometrics Unavailable"
          }
        }
      }
    },
    "camera.permission.body": {
      "comment": "Tells the reader where the camera switch lives. 'Settings', 'Privacy' and 'Camera' are the names of system screens and must match the ones iOS ships in this language.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Settings > Privacy > Camera and enable access for this app."
          }
        }
      }
    },
    "camera.permission.openSettings": {
      "comment": "Button that opens this app's page in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "camera.permission.title": {
      "comment": "Heading of the camera-permission banner.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Access Required"
          }
        }
      }
    },
    "component.dismiss": {
      "comment": "VoiceOver action that takes an error banner away. Not a button: activating it retries nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        }
      }
    },
    "component.loading": {
      "comment": "Accessibility value on a design-system button mid-request. Present participle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading"
          }
        }
      }
    },
    "component.spokenError %@": {
      "comment": "How an error banner is announced. The word carries what the hidden triangle draws, so a reader hears that the sentence is an error. %@ is the message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error: %@"
          }
        }
      }
    },
    "error.auth.invalidCredentials": {
      "comment": "Sign-in was rejected. Deliberately does not say which half was wrong.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid email or password."
          }
        }
      }
    },
    "error.auth.networkUnavailable": {
      "comment": "The sign-in request never reached the server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network connection."
          }
        }
      }
    },
    "error.barcode.processingFailed %@": {
      "comment": "Vision could not read the frame. %@ is the framework's own message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan failed: %@"
          }
        }
      }
    },
    "error.camera.configurationFailed": {
      "comment": "The capture session could not be assembled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to configure the capture session."
          }
        }
      }
    },
    "error.camera.deviceUnavailable": {
      "comment": "There is no camera to capture from.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera device is available on this device."
          }
        }
      }
    },
    "error.camera.notAuthorized": {
      "comment": "Camera access is denied. 'Settings', 'Privacy' and 'Camera' name system screens.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access was denied. Enable it in Settings > Privacy > Camera."
          }
        }
      }
    },
    "error.social.invalidCredential": {
      "comment": "The identity provider returned something unusable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in credential was invalid."
          }
        }
      }
    },
    "error.social.notConfigured": {
      "comment": "The provider has no client id in this build.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sign-in method is not configured."
          }
        }
      }
    },
    "error.social.tokenExchangeFailed": {
      "comment": "The provider's token was not accepted by this app's own server.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to exchange the social token for app credentials."
          }
        }
      }
    },
    "error.social.userCancelled": {
      "comment": "The reader dismissed the provider's sheet.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was cancelled."
          }
        }
      }
    },
    "error.textRecognition.noResult": {
      "comment": "The pass completed and found nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text found in the image."
          }
        }
      }
    },
    "error.textRecognition.processingFailed %@": {
      "comment": "Vision could not read the frame. %@ is the framework's own message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognition failed: %@"
          }
        }
      }
    },
